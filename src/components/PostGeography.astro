---
import { withBase, atlasSelectionPath } from "../utils/urls";
import type { ResolvedPost } from "../utils/atlas-graph";
interface Props { references: ResolvedPost }
const { references } = Astro.props;
const trips = [...new Map(references.trips.map((trip) => [trip.id, trip])).values()];
const places = [...new Map(references.places.map((place) => [place.id, place])).values()];
---

{(places.length > 0 || trips.length > 0) && (
  <section class="post-geography" aria-labelledby="post-geography-title" data-pagefind-ignore>
    <h2 id="post-geography-title">Explore in Atlas</h2>
    {trips.length > 0 && <p><strong>Trips:</strong> {trips.map((trip, index) => <Fragment>{index > 0 && ", "}<a href={withBase(atlasSelectionPath("trip", trip.id))}>{trip.name}</a></Fragment>)}</p>}
    {places.length > 0 && <p><strong>Places:</strong> {places.map((place, index) => <Fragment>{index > 0 && ", "}<a href={withBase(atlasSelectionPath("place", place.id))}>{place.name}</a></Fragment>)}</p>}
  </section>
)}
