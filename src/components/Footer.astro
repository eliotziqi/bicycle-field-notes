---
import { withBase } from "../utils/urls";
import { SITE } from "../config";
---

<footer class="site-footer">
  <div class="frame">
    <span>
      &copy; {new Date().getFullYear()} {SITE.title}
    </span>
    {SITE.social.length > 0 && (
      <ul>{SITE.social.map((l) => <li><a href={withBase(l.href)}>{l.label}</a></li>)}</ul>
    )}
  </div>
</footer>
