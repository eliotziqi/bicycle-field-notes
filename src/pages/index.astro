---
import { withBase } from "../utils/urls";
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import { SITE } from "../config";
import { getPosts } from "../utils/posts";

const posts = (await getPosts()).slice(0, SITE.postsOnHome);
---

<Base>
  <section class="col intro">
    <h1 class="page-title">{SITE.title}</h1>
    <p class="page-lede">{SITE.description}</p>
  </section>
  <section class="col">
    <h2 class="section-title">Recent posts</h2>
    {posts.length > 0 ? (
      <Fragment>
        <PostList posts={posts} />
        <p class="more"><a href={withBase("/posts")}>All posts</a></p>
      </Fragment>
    ) : (
      <p>Field notes coming soon.</p>
    )}
  </section>
</Base>
