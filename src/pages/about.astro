---
import Base from "../layouts/Base.astro";
import { SITE } from "../config";
---

<Base title="About" description={`About ${SITE.title}: cycling, travel, routes, and observations from the road.`}>
  <div class="col">
    <h1 class="page-title">About</h1>
    <div class="prose" style="font-size: 1.125rem; margin-top: 1.5rem;">
      <p>
        Bicycle Field Notes is a notebook for cycling routes, travel, and observations along the way.
        It brings together ride reports, practical notes, and details from the places a bicycle can take you.
      </p>
      <p>More about the rider coming soon.</p>
    </div>
  </div>
</Base>
